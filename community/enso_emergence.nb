Cell["\<\
Figure 4.1  Conceptual calendar wheel of the spring predictability barrier. \
The Bjerknes coupled-feedback strength (blue curve) is positive in autumn \
(growth) and near zero or negative in spring (damping). The \
westerly-wind-burst (WWB) intensity (orange) peaks in March\[Dash]April. \
Forecasts crossing the spring sector lose initial-condition information to \
the combination of strong stochastic kicks and weak coupled feedback. \
Generated with OpenAI gpt-image-2.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"2ff9e860-a1cf-4211-88ae-9592c4f37e9c"],

Cell[TextData[{
 StyleBox["The quantitative version.",
  FontSlant->Italic],
 " Define the lagged autocorrelation of the observed Ni\[NTilde]o 3.4 anomaly \
as a function of the initial calendar month ",
 StyleBox["m\:2080",
  FontFamily->"Times",
  FontSlant->Italic],
 " and the lead time \[Tau] (in months):"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"48a6b346-b909-47b9-9002-9c708c383636"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Rho]", "(", 
   SubscriptBox["m", "0"], ",", "\[Tau]", ")", "=", 
   FractionBox[
    RowBox[{"E", "[", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"T", "(", 
         RowBox[{"y", ",", 
          SubscriptBox["m", "0"]}], ")"}], "-", 
        OverscriptBox["T", "_"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"T", "(", 
         RowBox[{
          RowBox[{"y", "+", 
           RowBox[{"\[LeftFloor]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["m", "0"], "+", "\[Tau]", "-", "1"}], ")"}], "/", 
             "12"}], "\[RightFloor]"}]}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"mod", "(", 
            RowBox[{
             RowBox[{
              SubscriptBox["m", "0"], "+", "\[Tau]", "-", "1"}], ",", "12"}], 
            ")"}]}]}], ")"}], "-", 
        OverscriptBox["T", "_"]}], ")"}]}], " ", "]"}], 
    RowBox[{
     SubscriptBox["\[Sigma]", "T"], "(", 
     SubscriptBox["m", "0"], ")", " ", 
     SubscriptBox["\[Sigma]", "T"], "(", 
     RowBox[{"1", "+", 
      RowBox[{"mod", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["m", "0"], "+", "\[Tau]", "-", "1"}], ",", "12"}], 
       ")"}]}], ")"}]]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"dbdf75d5-7c2b-4c16-8ade-81c4ac5e81c1"],

Cell[TextData[{
 "\[Rho]",
 " is computed across all available years ",
 StyleBox["y",
  FontFamily->"Times",
  FontSlant->Italic],
 "; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "T"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6981bcde-3c62-4763-984e-6e0401819401"],
 " is the marginal standard deviation for that calendar month; the floor and \
mod arithmetic carry the verification time forward into the next year when ",
 StyleBox["m\:2080 + \[Tau] > 12",
  FontFamily->"Times",
  FontSlant->Italic],
 ". By construction ",
 StyleBox["\[Rho](m\:2080, 0) = 1",
  FontFamily->"Times",
  FontSlant->Italic],
 ". If ENSO were a white-noise process, ",
 StyleBox["\[Rho]",
  FontFamily->"Times",
  FontSlant->Italic],
 " would collapse to zero for any \[Tau] \[GreaterEqual] 1. If it were a pure \
sinusoid, ",
 StyleBox["\[Rho]",
  FontFamily->"Times",
  FontSlant->Italic],
 " would oscillate forever between \[PlusMinus] 1."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"412d7509-2f4f-4612-9948-a39aa0613050"],

Cell["\<\
Computing this from 77 years of monthly ERSSTv5 anomalies gives:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"3b1aa5d5-08f2-4468-bc5a-9a138b821140"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 4.2: observed lagged autocorrelation rho(m0, lead).
   Flatten the monthly anomalies into a single vector indexed by
   (year - y0)*12 + month so lead lookups are O(1) offsets, then
   correlate for each (initial-month, lead) pair. *)
n34 = LoadNino34[];
years = Sort @ DeleteDuplicates @ n34[\"year\"];
{y0, y1} = MinMax[years];
nMonths = (y1 - y0 + 1)*12;
flat = ConstantArray[Missing[\"NotAvailable\"], nMonths];
MapThread[
   (flat[[(#1 - y0)*12 + #2]] = #3) &,
   {n34[\"year\"], n34[\"month\"], n34[\"anom\"]}];

pairAt[m1_, tau_] := Module[{idx0, pairs},
   idx0 = Range[m1, nMonths - tau, 12];
   pairs = Transpose[{flat[[idx0]], flat[[idx0 + tau]]}];
   Select[pairs, And @@ (NumberQ /@ #) &]];

rhoMatrix = Table[
   With[{p = pairAt[m1, tau]},
      If[Length[p] < 4, 0., Correlation[p[[All, 1]], p[[All, 2]]]]],
   {tau, 0, 15}, {m1, 1, 12}];

(* Heatmap: rows = lead 0..15 from top, columns = Jan..Dec.
   monthNames is loaded from the helpers package by the Setup cell. *)
cmap = Blend[{
   {-0.2, RGBColor[0.65, 0.10, 0.10]},
   { 0.0, RGBColor[0.90, 0.50, 0.40]},
   { 0.3, RGBColor[0.97, 0.97, 0.95]},
   { 0.6, RGBColor[0.35, 0.55, 0.85]},
   { 1.0, RGBColor[0.05, 0.20, 0.55]}}, #] &;
ArrayPlot[rhoMatrix,
   ColorFunction -> cmap, ColorFunctionScaling -> False,
   Frame -> True,
   FrameLabel -> {{\"initial calendar month m\\:2080\", None},
                  {\"lead (months)\", None}},
   FrameTicks -> {
     {Table[{tau + 1, ToString[tau]}, {tau, 0, 15}],
      Table[{tau + 1, ToString[tau]}, {tau, 0, 15}]},
     {Table[{m, monthNames[[m]]}, {m, 12}],
      Table[{m, monthNames[[m]]}, {m, 12}]}},
   Mesh -> All, MeshStyle -> Directive[GrayLevel[0.85]],
   ImageSize -> 820, AspectRatio -> 1.05]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"34cb39a3-edc7-499e-b4dc-f687189de26c"],

