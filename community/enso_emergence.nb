Cell["\<\
Figure 5.1  The four phases of the recharge\[Dash]discharge ENSO cycle (Jin \
1997), drawn schematically. (I) Pre-event recharge: thermocline anomalously \
deep across the basin, heat content elevated. (II) El Ni\[NTilde]o: warm pool \
sloshes east, thermocline flattens, eastern SST anomalously warm. (III) \
Discharge: basin-wide upper-ocean heat content depleted by poleward Sverdrup \
transport during the event. (IV) La Ni\[NTilde]a: thermocline steeply tilted, \
eastern cold tongue intensified. The cycle then restarts. Generated with \
OpenAI gpt-image-2.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"544ca450-fb63-457a-8934-80da55c932c6"],

Cell[CellGroupData[{

Cell["5.1  Recharge\[Dash]discharge oscillator (Jin 1997)", "Subsection",ExpressionUUID->"6a27f0dc-2822-4194-89eb-309b73f948b1"],

Cell[TextData[{
 StyleBox["Conceptual reduction.",
  FontSlant->Italic],
 " Following Jin (1997), reduce the equatorial Pacific to two state variables:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"fe92379e-dc81-44db-b355-8464e322adf5"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["T(t)",
  FontFamily->"Times",
  FontSlant->Italic],
 " = eastern equatorial SST anomaly (\[Degree]C), proxied operationally by Ni\
\[NTilde]o 3.4."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"a66fb6e5-47db-4a2a-85bc-9b7f1f41d252"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["h(t)",
  FontFamily->"Times",
  FontSlant->Italic],
 " = western (or basin-mean) equatorial thermocline-depth anomaly, proxied by \
warm water volume above the 20 \[Degree]C isotherm. Positive ",
 StyleBox["h",
  FontFamily->"Times",
  FontSlant->Italic],
 " means \[OpenCurlyDoubleQuote]more heat in the upper ocean than climatology\
\[CloseCurlyDoubleQuote] (recharged); negative means discharged."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"f2639009-799b-4535-b48d-492b04d4424c"],

Cell[TextData[{
 StyleBox["Deterministic core.",
  FontSlant->Italic],
 " The linearised SST budget gives"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"4d1f9604-8245-470a-9a7b-3e8034af2111"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["dT", "dt"], "=", 
   RowBox[{"R", " ", "T"}], "+", 
   RowBox[{"\[Gamma]", " ", "h"}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"371cd375-a02c-4988-982b-c3e02f56ef9b"],

Cell[TextData[{
 "where ",
 StyleBox["R",
  FontFamily->"Times",
  FontSlant->Italic],
 " (units of inverse months) is the net Bjerknes-feedback growth rate \
(positive Bjerknes minus thermodynamic damping) and ",
 StyleBox["\[Gamma]",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the strength with which an anomalously deep western thermocline pushes \
warm water eastward and warms the east."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"e686ab22-3b29-48e4-8958-24565398a4e4"],

Cell["\<\
The ocean-adjustment equation closes the system by transporting heat content \
out of the basin in proportion to wind-stress-curl-driven Sverdrup flow:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"84a30401-c4fb-444c-b76c-ed19590738f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["dh", "dt"], "=", 
   RowBox[{
    RowBox[{"-", "r"}], " ", "h"}], "-", 
   RowBox[{"\[Alpha]", " ", "T"}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"0762323e-ff1a-43d1-8e40-00cd48c0adbb"],

Cell[TextData[{
 StyleBox["r",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the ocean-adjustment relaxation rate (1/years), and ",
 StyleBox["\[Alpha]",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the (negative) wind-stress feedback: an anomalously warm east produces \
an anomalously eastward wind stress, which drains the western recharge. \
Together this is a 2 \[Times] 2 linear system with eigenvalues"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"b3d94d31-f56a-47d2-b585-e288cfcb5361"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Lambda]", "\[PlusMinus]"], "=", 
   FractionBox[
    RowBox[{"R", "-", "r"}], "2"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"R", "+", "r"}], "2"], ")"}], "2"], "-", 
     RowBox[{"\[Gamma]", " ", "\[Alpha]"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"c1d8b674-e8c4-4076-b2f0-b85ba6963d79"],

Cell[TextData[{
 "For the parameter regime relevant to nature (",
 StyleBox["\[Gamma] \[Alpha] > ((R + r)/2)\.b2",
  FontFamily->"Times",
  FontSlant->Italic],
 "), the square root is imaginary and the system oscillates with frequency ",
 StyleBox["\[Omega] = \[Sqrt](\[Gamma] \[Alpha] \[Minus] ((R + r)/2)\.b2)",
  FontFamily->"Times",
  FontSlant->Italic],
 " and growth/decay rate ",
 StyleBox["(R \[Minus] r)/2",
  FontFamily->"Times",
  FontSlant->Italic],
 ". With canonical parameters this gives an oscillation period of 3\[Dash]6 \
years, in the observed ENSO band."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"80f9f09b-770f-4709-bd53-27dd6278cc15"],

Cell[TextData[{
 StyleBox["Adding the stochastic forcing.",
  FontSlant->Italic],
 " A purely deterministic RDO either decays to the origin (sub-critical: ",
 StyleBox["R < r",
  FontFamily->"Times",
  FontSlant->Italic],
 ") or explodes to infinity (super-critical). Neither matches observations. \
The standard remedy is multiplicative-then-additive stochastic forcing \
(Burgers, Jin & van Oldenborgh 2005) representing all the high-frequency \
atmospheric weather that the slow ocean mode does not resolve:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"29fdb9c5-5fc2-4f4f-b131-022a23e7fc6c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["dT", "dt"], "=", 
   RowBox[{"R", "(", "t", ")", " ", "T"}], "+", 
   RowBox[{"\[Gamma]", " ", "h"}], "+", 
   RowBox[{
    SubscriptBox["\[Sigma]", "T"], " ", 
    SubscriptBox["\[Xi]", "T"], "(", "t", ")"}], "+", 
   RowBox[{
    SubscriptBox["\[Sigma]", "w"], "(", "t", ")", " ", 
    SubscriptBox["\[Xi]", "w"], "(", "t", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"3159b31a-88d5-4b6b-a651-4fd420c88797"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["dh", "dt"], "=", 
   RowBox[{
    RowBox[{"-", "r"}], " ", "h"}], "-", 
   RowBox[{"\[Alpha]", " ", "T"}], "+", 
   RowBox[{
    SubscriptBox["\[Sigma]", "h"], " ", 
    SubscriptBox["\[Xi]", "h"], "(", "t", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"1fefa349-0a53-4942-ba2c-742dbb8fa969"],

Cell[TextData[{
 "where the three ",
 StyleBox["\[Xi](t)",
  FontFamily->"Times",
  FontSlant->Italic],
 " are independent unit white noises (formally d",
 StyleBox["W",
  FontFamily->"Times",
  FontSlant->Italic],
 "/d",
 StyleBox["t",
  FontFamily->"Times",
  FontSlant->Italic],
 "), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "T"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9b191b10-b88b-46db-94b4-4574570808c7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "h"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"84c79b90-432f-42e0-8dcb-c40e4bde422e"],
 " are the slow (synoptic + sub-monthly) stochastic forcing amplitudes, and \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "w"], "(", "t", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ad4279ea-0e4d-4b06-8b1c-73b77ba77f0d"],
 " is the specifically-westerly-wind-burst forcing whose variance peaks in \
boreal spring."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"fd590681-852c-4fc2-b995-754df8054400"],

Cell[TextData[{
 StyleBox["The Stein\[Dash]Levine\[Dash]Jin seasonal mechanism.",
  FontSlant->Italic],
 " Two coefficients are taken to be seasonally periodic:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"2c925b49-8b87-42b4-a0ab-d7b245167b8a"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", "(", "t", ")", "=", 
   SubscriptBox["R", "0"], "+", 
   RowBox[{
    SubscriptBox["R", "1"], " ", 
    RowBox[{"cos", "(", 
     FractionBox[
      RowBox[{"2", "\[Pi]", "(", "t", "-", "9", ")"}], "12"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"9000038e-8b3e-4a69-8680-5303dc22de3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Sigma]", "w"], "(", "t", ")", "=", 
   SubscriptBox["\[Sigma]", 
    RowBox[{"w", ",", "0"}]], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
      SubscriptBox["a", "w"], " ", 
      RowBox[{"cos", "(", 
       FractionBox[
        RowBox[{"2", "\[Pi]", "(", "t", "-", "3", ")"}], "12"], ")"}]}]}], 
    ")"}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"8b143474-c350-4146-8463-d62dd22a84a6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "t", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0a5a0f95-5045-45cf-be71-210aa84daff0"],
 " peaks in September (most positive, strongest growth) and dips in March \
(least positive or negative, strongest damping); ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "w"], "(", "t", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"633db445-e189-46f5-adb4-76cd5ca8caf4"],
 " peaks in March\[Dash]April (spring WWB activity), giving the model an \
in-built spring barrier. The two cycles together:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"669b87d3-14ec-4824-9fbb-fc73beba0c1f"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 5.2: seasonal cycles of R(t) and sigma_w(t).
   Rseason, sigWWB, and all parameter values are already loaded from
   enso_emergence_helpers.wl by the Setup cell at the top of the post;
   we just plot them here. *)
Plot[{Rseason[t - 1, 1], sigWWB[t - 1, 1]}, {t, 1, 13},
   PlotStyle -> {RGBColor[0.05, 0.20, 0.55], RGBColor[0.85, 0.32, 0.10]},
   PlotLegends -> {
      \"R(t)  Bjerknes feedback\",
      Row[{Subscript[\"\\[Sigma]\", \"w\"], \"(t)  WWB std-dev\"}]},
   Frame -> True, Axes -> False,
   FrameTicks -> {{Automatic, None},
      {Table[{m, monthNames[[m]]}, {m, 12}], None}},
   FrameLabel -> {{\"value (month\\[Minus]\\:00b9 or \\[Degree]C)\", None},
                  {\"calendar month\", None}},
   GridLines -> {None, {0}},
   ImageSize -> 720, AspectRatio -> 0.55]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"9c10098c-f495-489b-9077-db409d5d920f"],

