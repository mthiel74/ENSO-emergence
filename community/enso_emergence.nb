Cell[TextData[{
 "Figure 5.8  A 20-year realisation of the delayed oscillator with ",
 StyleBox["\[Alpha] = 0.75",
  FontFamily->"Times",
  FontSlant->Italic],
 " and ",
 StyleBox["\[Delta] = 6",
  FontFamily->"Times",
  FontSlant->Italic],
 " months. The system sits below the pitchfork threshold ",
 StyleBox["\[Alpha] = 1",
  FontFamily->"Times",
  FontSlant->Italic],
 " so the deterministic skeleton has unstable origin saturated by the cubic; \
the delayed negative feedback produces sustained oscillations of period ",
 StyleBox["\[TildeTilde] 4\[Delta] = 24",
  FontFamily->"Times",
  FontSlant->Italic],
 " months \[LongDash] shorter than the canonical 3\[Dash]6-year ENSO band, \
but the delay-induced limit-cycle phenomenology is correct."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"988745a0-94ba-44e3-9372-6cb9ca787138"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 5.9: DDE ensemble cones. Same percentile-band pattern as
   Figure 5.5 but the underlying dynamics are the delay-induced limit
   cycle, not the stochastic-RDO recharge mode.

   PERFORMANCE: the displayed figure used 400 members; this cell uses
   150 to keep it under ~40 s. The first call also builds a 400-yr
   model climatology pool (a few seconds, one-time). *)

panelDDE[m0_, nMem_:150] := Module[{f},
   PrintTemporary[\"DDE ensemble for init month \", m0, \" ...\"];
   f = forecastEnsembleDDE[m0, nMem, 18, 0.05];
   Show[
      ListLinePlot[{Transpose[{f[\"t\"], f[\"p05\"]}],
                    Transpose[{f[\"t\"], f[\"p95\"]}]},
         Filling -> {1 -> {{2}, Directive[Opacity[0.20],
            RGBColor[0.20, 0.45, 0.75]]}}],
      ListLinePlot[{Transpose[{f[\"t\"], f[\"p25\"]}],
                    Transpose[{f[\"t\"], f[\"p75\"]}]},
         Filling -> {1 -> {{2}, Directive[Opacity[0.45],
            RGBColor[0.20, 0.45, 0.75]]}}],
      ListLinePlot[Transpose[{f[\"t\"], f[\"median\"]}],
         PlotStyle -> Directive[Thickness[0.005], Black]],
      Frame -> True, PlotRange -> {{0, 18}, {-1.6, 1.6}},
      AspectRatio -> 0.7, ImageSize -> 520]];

Grid[Partition[panelDDE /@ {1, 4, 7, 10}, 2], Spacings -> {1.5, 1.5}]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"56288a4f-e153-4f49-b42d-98cccc0291f5"],

