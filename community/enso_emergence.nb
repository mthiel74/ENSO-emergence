Cell[TextData[{
 "Figure 5.7  Stationary min and max of T in long stochastic runs of the \
delayed oscillator, as a function of the wave-coupling ",
 StyleBox["\[Alpha]",
  FontFamily->"Times",
  FontSlant->Italic],
 ", with ",
 StyleBox["\[Delta] = 3",
  FontFamily->"Times",
  FontSlant->Italic],
 " (= 6 months) held fixed. At small ",
 StyleBox["\[Alpha]",
  FontFamily->"Times",
  FontSlant->Italic],
 " (~0.3) the trajectory remains trapped in one of the ",
 StyleBox["\[PlusMinus]\[Sqrt](1\[Minus]\[Alpha])",
  FontFamily->"Times",
  FontSlant->Italic],
 " deterministic basins and the peak-to-peak swing is small (\[TildeTilde] \
0.9); as ",
 StyleBox["\[Alpha]",
  FontFamily->"Times",
  FontSlant->Italic],
 " grows toward 1 the delayed negative feedback becomes strong enough to \
drive a full sign-reversing limit cycle of peak-to-peak \[TildeTilde] 3 (i.e. \
",
 StyleBox["\[PlusMinus]1.5",
  FontFamily->"Times",
  FontSlant->Italic],
 ")."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"784d0421-4f62-444b-9574-3b88381a3f4f"],

Cell[TextData[{
 StyleBox["Implementation.",
  FontSlant->Italic],
 " The Wolfram implementation maintains a circular history buffer so the \
delayed value ",
 StyleBox["T(t-\[Delta])",
  FontFamily->"Times",
  FontSlant->Italic],
 " is available at every step without recomputation:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"f7d4930b-53a1-4919-82c5-736aedfc4850"],

Cell["\<\
simulateDDE[m0_, tEnd_, dt_, hist0_, seed_] := Module[
   {nHist, hist, idx, T, t, sqrtDt, ts, Ts, eta, Tdel, drift, diff, nSteps, i},
   SeedRandom[seed];
   nHist  = Ceiling[delayTau/dt] + 2;
   hist   = ConstantArray[hist0, nHist];   (* circular buffer *)
   idx    = 1;  T = hist0;  t = 0.;
   nSteps = Round[tEnd/dt];   sqrtDt = Sqrt[dt];
   ts = ConstantArray[0., nSteps + 1];
   Ts = ConstantArray[0., nSteps + 1];
   ts[[1]] = 0.; Ts[[1]] = T;
   Do[
     With[{kBack = Round[delayTau/dt]},
        Tdel = hist[[1 + Mod[idx - 1 - kBack + nHist, nHist]]]];
     drift = T - alphaDel Tdel - T^3;
     diff  = sigStoch[t, m0];
     eta   = RandomVariate[NormalDistribution[]];
     T += dt drift + sqrtDt diff eta;
     t += dt;
     idx = 1 + Mod[idx, nHist];   hist[[idx]] = T;
     ts[[i + 1]] = t; Ts[[i + 1]] = T,
     {i, nSteps}];
   <|\"t\" -> ts, \"T\" -> Ts|>
];\
\>", "Program",
 CellMargins->{{60, 30}, {6, 6}},
 ShowStringCharacters->False,
 FontFamily->"Courier",
 FontSize->11,
 Background->RGBColor[
  0.95, 0.96, 0.98],ExpressionUUID->"388182a4-fbca-43cf-8c1a-4125e0b42eab"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 5.8: a 20-year realisation at alpha=0.75, delta=6 mo *)
alphaDel = 0.75; delayTau = 3.0;
samp = simulateDDE[1, 20*12/2., 0.05, 0.3, 7];
ListLinePlot[Transpose[{samp[\"t\"]*2./12., samp[\"T\"]}],
   PlotStyle -> Directive[Thickness[0.003], RGBColor[0.20, 0.45, 0.75]],
   Frame -> True,
   FrameLabel -> {{\"T anomaly\", None}, {\"years\", None}},
   PlotRange -> {Automatic, {-1.6, 1.6}},
   GridLines -> {Automatic, {-0.5, 0, 0.5}},
   ImageSize -> 950, AspectRatio -> 1/3.2]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"6fa85541-349e-471e-8a27-c88069dcf35f"],

