}, Open  ]],

Cell[CellGroupData[{

Cell["2.  The spring predictability barrier", "Section",ExpressionUUID->"1b739602-9983-4e63-a0a5-ef8440088a9c"],

Cell[TextData[{
 "ENSO forecasts initialised in boreal winter and spring are notoriously \
unreliable. The phenomenon is called the ",
 StyleBox["spring predictability barrier",
  FontWeight->Bold],
 ". It is not a feature of any single forecast model; it shows up directly in \
the observational record."
}], "Text",ExpressionUUID->"dcd09da7-afd5-41c6-beff-5bcd8ac61333"],

Cell[TextData[{
 "For each calendar month ",
 StyleBox["m\:2080",
  FontSlant->Italic],
 " and each lead \[Tau], we compute the lagged Pearson correlation of the Ni\
\[NTilde]o 3.4 anomaly:"
}], "Text",ExpressionUUID->"db006628-c8fb-4dd1-be09-130a3549863f"],

Cell[BoxData[
 RowBox[{"\[Rho]", "(", "m\:2080", ",", "\[Tau]", ")", "=", "corr", "(", 
  RowBox[{"T", "(", "y", ",", "m\:2080", ")"}], ",", 
  RowBox[{"T", "(", "y", "\[Prime]", ",", 
   RowBox[{"m\:2080", "+", "\[Tau]"}], ")"}], ")"}]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"36c62ef6-ad39-4f24-9428-a122b1183f67"],

Cell[TextData[{
 "with the verification time shifted to the next year whenever ",
 StyleBox["m\:2080 + \[Tau]",
  FontSlant->Italic],
 " > 12. The result is a striking V-shaped valley pointing into the April\
\[Dash]June verification window:"
}], "Text",ExpressionUUID->"2bd0dbfd-62c5-497f-9e28-bbbdd53530a9"],

