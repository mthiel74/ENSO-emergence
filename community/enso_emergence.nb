Cell["\<\
Figure 5.3  Single 20-year stochastic realisation of the \
recharge\[Dash]discharge oscillator with seasonally modulated coefficients. \
Period is irregular (3\[Dash]6 years) and amplitude is variable, as in \
observations.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"81bfb8e0-d0e2-4d48-90ba-adeaeff3feed"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 5.4: phase-space orbit of (T, h) from the same run *)
ListLinePlot[Transpose[{samp[\"T\"], samp[\"h\"]}],
   PlotStyle -> Directive[Thickness[0.0012], Opacity[0.55],
      RGBColor[0.20, 0.40, 0.65]],
   Frame -> True,
   FrameLabel -> {{\"thermocline anomaly h\", None},
                  {\"SST anomaly T (\\[Degree]C)\", None}},
   GridLines -> {{0}, {0}},
   ImageSize -> 480, AspectRatio -> 1]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"2a129b00-f040-410a-9649-521e610c0e3a"],

