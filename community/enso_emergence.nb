Cell["\<\
Monthly Ni\[NTilde]o 3.4 SST anomaly from NOAA PSL (ERSSTv5, base period 1991\
\[Dash]2020). The April 2026 value is +0.23 \[Degree]C, up from -0.67 \
\[Degree]C in December 2025 \[LongDash] one of the sharpest spring \
transitions in the record.\
\>", "Caption",
 FontFamily->
  "Helvetica",ExpressionUUID->"b5a990e3-2795-4432-8ad4-750d642d9dee"],

Cell[BoxData[
 FontSlant -> Italic], "Input",ExpressionUUID->"c670aff9-0d06-49a3-8d0b-aa33732fbff5"],

