Notebook[{

Cell[CellGroupData[{
Cell["ENSO emergence and the spring predictability barrier", "Title",ExpressionUUID->"027b8f22-156a-4f35-97d4-6213e52c40fd"],

Cell["\<\
A live-data project on the May 2026 El Ni\[NTilde]o Watch and the classical \
toy models that explain why springtime ENSO forecasts collapse.\
\>", "Subtitle",ExpressionUUID->"023d7c6f-44ae-4e1b-89d9-082c1c29c542"],

Cell["Wolfram Community submission \[LongDash] May 2026", "Subtitle",
 FontSlant->Italic,ExpressionUUID->"811e1941-3ed1-4494-bd8d-a65d71519138"],

Cell[CellGroupData[{

Cell["1.  The El Ni\[NTilde]o Watch (May 2026)", "Section",ExpressionUUID->"70bde375-524f-4b01-aa70-9ae1e8fa8738"],

Cell[TextData[{
 "NOAA's Climate Prediction Center currently has an ",
 StyleBox["El Ni\[NTilde]o Watch",
  FontWeight->Bold],
 " in effect. The May 2026 ENSO Diagnostic Discussion gives an ",
 StyleBox["~82% probability",
  FontWeight->Bold],
 " of El Ni\[NTilde]o onset during May\[Dash]July 2026 and a ",
 StyleBox["~96% probability",
  FontWeight->Bold],
 " that the event persists through December 2026\[Dash]February 2027. The \
tropical Pacific has just emerged from a weak La Ni\[NTilde]a and the \
equatorial cold tongue is warming sharply."
}], "Text",ExpressionUUID->"b6788bba-5fd5-4b2a-8619-c6cd7f0199a5"],

