Cell["\<\
Figure 4.2  Observed Ni\[NTilde]o 3.4 lagged autocorrelation \[Rho](m\:2080, \
lead). Rows = lead in months, columns = initial calendar month. Deep blue = \
high autocorrelation (skillful persistence), red = low or negative \
correlation. The classic V-shaped low-correlation valley pointing into the \
May\[Dash]July verification window is the spring predictability barrier.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"070a2a1c-2cd2-4aa1-a0b3-1a530ce53cf4"],

Cell[TextData[{
 StyleBox["What the heatmap is telling you.",
  FontSlant->Italic],
 " Read down any column. For an initial month of October (m\:2080 = 10), the \
autocorrelation stays above 0.5 all the way out to 12 months (verifying in \
next October). For an initial month of January (m\:2080 = 1), the \
autocorrelation drops below 0.2 by lead 5 (verifying in June). Same dataset, \
same statistic, hugely different behaviour. The asymmetry is the barrier."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"ff4a8fcc-7c4b-4f96-a7d1-df5ad67a6c2e"],

Cell["\<\
The same data in a different cut: the persistence-skill curves collapse by \
start month.\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"d33ecdef-ea39-4fc8-b32b-6b48c7d9d9ab"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 4.3: persistence-skill curves, one per starting month *)
ListLinePlot[
   Table[
      Tooltip[
         Transpose[{Range[0, 15], rhoMatrix[[All, m1]]}],
         monthNames[[m1]]],
      {m1, 12}],
   PlotRange -> {{0, 15}, {-0.2, 1.05}},
   Frame -> True,
   FrameLabel -> {{\"autocorrelation \\[Rho]\", None},
                  {\"lead (months from m\\:2080)\", None}},
   GridLines -> {Automatic, {0, 0.5}},
   GridLinesStyle -> Directive[Gray, Dashed],
   PlotLegends -> Placed[monthNames, Right],
   ImageSize -> 900, AspectRatio -> 0.55]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"a3492908-d7fc-4922-b5a2-4dda6b1693a9"],

