Cell["\<\
The same data, sliced as persistence-skill curves vs lead. Jan/Feb starts \
(purple/blue, top of legend) drop fastest; Jul/Aug starts (red/orange) keep \
\[Rho] > 0.7 out to 9-month leads.\
\>", "Caption",
 FontFamily->
  "Helvetica",ExpressionUUID->"1fab7209-a6aa-4845-9896-6c5976deaa8f"],

Cell[BoxData[
 FontSlant -> Italic], "Input",ExpressionUUID->"9cf8a3dc-3125-4baf-acb6-d3e80c887411"],

Cell[BoxData[
 FontSize -> 11], "Input",ExpressionUUID->"d8c67281-fcbb-4741-803c-0a26a6da2030"],

Cell["Caption", "Input",ExpressionUUID->"c073a770-16e9-4e89-88a1-508320557f29"],

Cell[BoxData[
 CellMargins -> {{60, 60}, {2, 14}}], "Input",ExpressionUUID->"73abaccb-bade-4cb5-adb8-4cbd10152128"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.  Two toy models that produce the barrier", "Section",ExpressionUUID->"6e2f43f2-e1c1-48a7-a806-c4e9f8caa40f"],

Cell[CellGroupData[{

Cell["3.1  The recharge\[Dash]discharge oscillator (Jin 1997)", "Subsection",ExpressionUUID->"d52ebbf6-d1cc-4ab3-b8e4-9e6d40fdd111"],

Cell[TextData[{
 "Jin's recharge\[Dash]discharge oscillator is the simplest 2-dimensional \
model that captures the ENSO cycle. It tracks the eastern equatorial SST \
anomaly ",
 StyleBox["T",
  FontSlant->Italic],
 " and the western equatorial thermocline depth anomaly ",
 StyleBox["h",
  FontSlant->Italic],
 ":"
}], "Text",ExpressionUUID->"d0fec60a-2d85-4220-86d3-a104e4447ec1"],

Cell[BoxData[
 RowBox[{
  FractionBox["dT", "dt"], "=", 
  RowBox[{"R", "(", "t", ")", "T"}], "+", 
  RowBox[{"\[Gamma]", " ", "h"}], "+", 
  SubscriptBox["\[Sigma]", "T"], 
  SubscriptBox["\[Xi]", "T"], "(", "t", ")", "+", 
  RowBox[{
   SubscriptBox["\[Sigma]", "w"], "(", "t", ")", 
   SubscriptBox["\[Xi]", "w"], "(", "t", ")"}]}]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"e2a0d645-8368-44d5-895e-4f1941b5779f"],

Cell[BoxData[
 RowBox[{
  FractionBox["dh", "dt"], "=", 
  RowBox[{"-", "r", " ", "h"}], "-", 
  RowBox[{"\[Alpha]", " ", "T"}], "+", 
  SubscriptBox["\[Sigma]", "h"], 
  SubscriptBox["\[Xi]", "h"], "(", "t", ")"}]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"625a8567-150f-4dba-922c-33936e0ac326"],

Cell[TextData[{
 "The Bjerknes feedback ",
 StyleBox["R(t)",
  FontSlant->Italic],
 " is positive (growth) in boreal autumn and negative (damping) in boreal \
spring, when the climatological trades are weakest. The stochastic \
westerly-wind-burst (WWB) variance ",
 StyleBox["\[Sigma]\_w(t)",
  FontSlant->Italic],
 " peaks in March\[Dash]April. This is the Stein \[Dash] Levine \[Dash] Jin \
mechanism for the spring barrier."
}], "Text",ExpressionUUID->"aba0712c-b12e-4cec-ab6d-94d8ce41e671"],

