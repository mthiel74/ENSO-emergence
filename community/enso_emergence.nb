Cell[TextData[{
 StyleBox["Scientific lineage.",
  FontSlant->Italic],
 " The recharge\[Dash]discharge oscillator is due to ",
 StyleBox["Fei-Fei Jin",
  FontWeight->Bold],
 " (1997); the delayed oscillator is due to ",
 StyleBox["Max Suarez",
  FontWeight->Bold],
 " and ",
 StyleBox["Paul Schopf",
  FontWeight->Bold],
 " (1988). The seasonal-modulation spring-barrier explanation we use here was \
developed by ",
 StyleBox["Aaron Levine",
  FontWeight->Bold],
 " and Fei-Fei Jin (2010) and by ",
 StyleBox["Karl Stein and collaborators",
  FontWeight->Bold],
 " (2010). The Bjerknes feedback itself, the foundation stone of coupled \
tropical ocean\[Dash]atmosphere theory, is due to ",
 StyleBox["Jacob Bjerknes",
  FontWeight->Bold],
 " (1969)."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"33413f2f-5b34-4fb7-9317-75b12372cf39"],

Cell[TextData[{
 StyleBox["Tools.",
  FontSlant->Italic],
 " All numerics and figures are pure ",
 StyleBox["Wolfram Language",
  FontWeight->Bold],
 " (Mathematica 14). The notebook was built programmatically via ",
 StyleBox["wolframscript",
  FontFamily->"Courier"],
 ". The educational illustrations (Figures 1.1, 1.2, 3.1, 4.1, 5.1) were \
generated with OpenAI's ",
 StyleBox["gpt-image-2",
  FontFamily->"Courier"],
 " model. The repository skeleton, git workflow, and notebook-build pipeline \
were assembled with the help of Anthropic's Claude Code."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"c0e3491b-6727-4c04-9a1e-e0612da157ac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.  Reproducibility", "Section",ExpressionUUID->"41de87c7-bae4-4a3b-8cf6-2135765816b0"],

Cell[TextData[{
 "All source code lives in the public repository ",
 StyleBox["github.com/mthiel74/ENSO-emergence",
  FontWeight->"SemiBold"],
 " (",
 StyleBox["https://github.com/mthiel74/ENSO-emergence",
  FontFamily->"Courier",
  FontSize->10],
 ")",
 ". The analysis pipeline (live data fetch \[Rule] toy models \[Rule] live \
forecast \[Rule] notebook build) is pure Wolfram Language; the one exception \
is a one-off Python script that calls OpenAI's ",
 StyleBox["gpt-image-2",
  FontFamily->"Courier"],
 " API to regenerate the five educational illustrations (Figures 1.1, 1.2, \
3.1, 4.1, 5.1) \[LongDash] their PNG outputs are committed to the repository \
so a normal rebuild does not invoke Python. To regenerate the notebook from \
scratch on a machine with Wolfram Language 14 installed:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"fa7c27f2-a3df-401c-8eca-d83cb599d3ef"],

Cell["\<\
# 1. Fetch the latest live data into data/
wolframscript -file wolfram/fetch_all.wls

# 2. Compute the observational spring-barrier figures
wolframscript -file wolfram/barrier.wls

# 3. Run the recharge-discharge oscillator ensembles
wolframscript -file wolfram/rdo.wls

# 4. Run the delayed oscillator ensembles
wolframscript -file wolfram/delayed.wls

# 5. Compute the live forecast overlay
wolframscript -file wolfram/forecast.wls

# 6. Render the spatial SST-anomaly time-lapse hero
wolframscript -file wolfram/hero.wls

# 7. Rebuild this notebook
wolframscript -file community/build_notebook.wls

# Steps 2-6 are also wrapped in wolfram/run_all.wls.\
\>", "Program",
 CellMargins->{{60, 30}, {6, 6}},
 ShowStringCharacters->False,
 FontFamily->"Courier",
 FontSize->11,
 Background->RGBColor[
  0.95, 0.96, 0.98],ExpressionUUID->"1b5d2d8f-f315-455e-8e05-273cf44f4557"],

Cell["\<\
The full pipeline runs in approximately 5 minutes on a 2024 MacBook M3. The \
.nb file (~5 MB with all images embedded) is committed to the repository so \
the notebook is browseable without running anything.\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"af41ce01-360c-4310-ae51-e560c1ae3863"],

Cell["Generated on May 18, 2026.",
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.4],ExpressionUUID->"720f8760-d211-4edc-82d3-7e0d35d6409b"]
}, Open  ]]
}, Open  ]]
},
