Cell[TextData[{
 "Figure 5.2  The two seasonally varying coefficients used in the recharge\
\[Dash]discharge model: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "t", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f2e342e0-07a1-41da-92be-eebf009fcef8"],
 " (blue) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "w"], "(", "t", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b2836c6f-7797-4eb7-bee9-da4174dd6962"],
 " (orange). The phase relationship is the heart of the Stein\[Dash]Levine\
\[Dash]Jin spring-barrier mechanism."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"4200f5bf-b430-4e82-ade6-d69e04cdf6ed"],

Cell[TextData[{
 StyleBox["Numerical integration.",
  FontSlant->Italic],
 " We use the Euler\[Dash]Maruyama scheme with time step ",
 StyleBox["dt = 0.05",
  FontFamily->"Times",
  FontSlant->Italic],
 " months (\[TildeTilde]36 hours). For each step:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"b70db429-11e1-4af5-a8ef-fa0fc6baa0ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"n", "+", "1"}]], "=", 
   SubscriptBox["T", "n"], "+", 
   RowBox[{"dt", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"R", "(", 
       SubscriptBox["t", "n"], ")", " ", 
       SubscriptBox["T", "n"]}], "+", 
      RowBox[{"\[Gamma]", " ", 
       SubscriptBox["h", "n"]}]}], ")"}]}], "+", 
   RowBox[{
    SqrtBox["dt"], "(", 
    SubscriptBox["\[Sigma]", "T"], " ", 
    SubscriptBox["\[Eta]", 
     RowBox[{"T", ",", "n"}]], "+", 
    RowBox[{
     SubscriptBox["\[Sigma]", "w"], "(", 
     SubscriptBox["t", "n"], ")", " ", 
     SubscriptBox["\[Eta]", 
      RowBox[{"w", ",", "n"}]]}], ")"}]}], TraditionalForm]], "DisplayFormula",\

 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"fc97d09a-47cd-4c42-992e-acd3f2fe93bf"],

Cell[TextData[{
 "with ",
 StyleBox["\[Eta]",
  FontFamily->"Times",
  FontSlant->Italic],
 " drawn from a standard normal. The Wolfram implementation is concise:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"bbad058b-21e8-47fa-9f36-5bd7da665f9b"],

Cell["\<\
simulate[T0_, h0_, m0_, tEnd_, dt_, seed_] := Module[
   {steps, T, h, t, sqrtDt, ts, Ts, hs, eT, eH, eW},
   SeedRandom[seed];
   steps  = Round[tEnd/dt];   sqrtDt = Sqrt[dt];
   T = T0; h = h0; t = 0.;
   ts = ConstantArray[0., steps + 1];
   Ts = ConstantArray[0., steps + 1];
   hs = ConstantArray[0., steps + 1];
   ts[[1]] = 0.; Ts[[1]] = T; hs[[1]] = h;
   Do[
     eT = RandomVariate[NormalDistribution[]];
     eH = RandomVariate[NormalDistribution[]];
     eW = RandomVariate[NormalDistribution[]];
     T += dt (Rseason[t, m0] T + gammaC h) +
           sqrtDt (sigmaT eT + sigWWB[t, m0] eW);
     h += dt (-rDamp h - alpha T) + sqrtDt sigmaH eH;
     t += dt;
     ts[[i + 1]] = t; Ts[[i + 1]] = T; hs[[i + 1]] = h,
     {i, steps}];
   <|\"t\" -> ts, \"T\" -> Ts, \"h\" -> hs|>
];\
\>", "Program",
 CellMargins->{{60, 30}, {6, 6}},
 ShowStringCharacters->False,
 FontFamily->"Courier",
 FontSize->11,
 Background->RGBColor[
  0.95, 0.96, 0.98],ExpressionUUID->"5cd87c1e-1be8-4a20-b441-fcb0e09973e2"],

Cell["\<\
A 20-year free run reproduces the irregular 3\[Dash]6-year-period ENSO \
oscillation with amplitude \[PlusMinus]2\[Dash]3 \[Degree]C:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"34475be4-93ac-4d9e-867f-969438a86efb"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 5.3: a single 20-year RDO realisation.
   simulate[] is already loaded from the Setup cell's
   Get[\"enso_emergence_helpers.wl\"]; the constants gammaC, rDamp,
   alpha, sigmaT, sigmaH are exported by the same package. *)
samp = simulate[0.3, 0.6, 1, 12*20, 0.05, 17];
ListLinePlot[Transpose[{samp[\"t\"]/12., samp[\"T\"]}],
   PlotStyle -> Directive[Thickness[0.003], RGBColor[0.83, 0.32, 0.10]],
   Frame -> True,
   FrameLabel -> {{\"T anomaly (\\[Degree]C)\", None}, {\"years\", None}},
   PlotRange -> {Automatic, {-3.5, 3.5}},
   GridLines -> {Automatic, {-0.5, 0, 0.5}},
   ImageSize -> 950, AspectRatio -> 1/3.2]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"e935fe63-fc3f-4a93-8299-e00df6bdf3a1"],

