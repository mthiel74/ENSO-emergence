Cell[CellGroupData[{

Cell["3.2  The delayed-action oscillator (Suarez & Schopf 1988)", "Subsection",ExpressionUUID->"cf590cb4-6cb1-46b1-a4dc-398c0bb21508"],

Cell[TextData[{
 "The delay model captures the same physics differently. It encodes the \
cross-basin ocean-wave round trip as an explicit delay ",
 StyleBox["\[Delta]",
  FontSlant->Italic],
 " (~6 months) on a single scalar SST anomaly:"
}], "Text",ExpressionUUID->"5f12b55f-5b81-47de-8276-f135b1a75ccb"],

Cell[BoxData[
 RowBox[{
  FractionBox["dT", "dt"], "=", "T", "-", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"T", "(", 
    RowBox[{"t", "-", "\[Delta]"}], ")"}]}], "-", 
  SuperscriptBox["T", "3"], "+", 
  RowBox[{
  "\[Sigma]", "(", "t", ")", " ", "\[Xi]", "(", "t", 
   ")"}]}]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"260dca62-15f9-4749-81a9-4cc32e459b40"],

Cell["\<\
We integrate with Euler\[Dash]Maruyama on a circular history buffer so the \
delayed value is available without recomputation:\
\>", "Text",ExpressionUUID->"7e6a79ba-3e5b-49d3-8669-85f375b137d7"],

