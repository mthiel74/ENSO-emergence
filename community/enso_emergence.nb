Cell["\<\
Figure 5.9  Delayed-oscillator ensemble forecast cones for four initial \
calendar months. The cones \[OpenCurlyDoubleQuote]breathe\
\[CloseCurlyDoubleQuote] with the underlying limit-cycle period \
(\[TildeTilde] 24 months) rather than showing a single spring-barrier window, \
because in this parameter regime the deterministic cycle dominates over the \
seasonal modulation of the stochastic forcing.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"98d9813d-2e95-4ab0-a196-2f90e4c8bf98"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.  Live forecast: initialising from April 2026", "Section",ExpressionUUID->"33e81906-a83d-4171-b40d-657c401bbef2"],

Cell[TextData[{
 StyleBox["Cell-evaluation order in this section.",
  FontWeight->Bold,
  FontSlant->Italic],
 "  Figure 6.1 assigns ",
 StyleBox["coneFig",
  FontFamily->"Courier"],
 "; Figure 2.1 assigned ",
 StyleBox["probBars",
  FontFamily->"Courier"],
 "; both are reused by the three-panel overlay in Figure 6.2. If you have not \
run Figures 2.1 and 6.1 yet, do that first."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{70, 70}, {6, 4}},
 CellFrameColor->RGBColor[0.78, 0.55, 0.15],
 FontSize->11,
 FontColor->GrayLevel[0.25],
 Background->RGBColor[
  0.97, 0.92, 0.78],ExpressionUUID->"26b40821-dc18-4fed-9a9b-6b1d4a4bf73b"],

Cell[TextData[{
 "To turn the RDO into a live forecast tool we need (a) the current observed ",
 StyleBox["T",
  FontFamily->"Times",
  FontSlant->Italic],
 " and (b) the current observed (or inferred) ",
 StyleBox["h",
  FontFamily->"Times",
  FontSlant->Italic],
 ". The first is just the latest Ni\[NTilde]o 3.4 anomaly: +0.23 \[Degree]C \
in April 2026. The second is harder \[LongDash] there is no clean monthly \
observational product for warm-water-volume anomaly that we can fetch live in \
the same way."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"36f63cd7-7f1c-4801-8b14-620f6530a9e0"],

Cell[TextData[{
 StyleBox["Inferring h from the recent tendency.",
  FontSlant->Italic],
 " The linearised SST equation gives a clean inversion. From"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"c0a037e3-fea1-4066-88a1-fd13e70710b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["dT", "dt"], "\[TildeTilde]", 
   RowBox[{"R", "(", "t", ")", " ", "T"}], "+", 
   RowBox[{"\[Gamma]", " ", "h"}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"9851753a-c558-4363-84cf-ad9e40829ce2"],

Cell["we get", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"9436efdd-1bea-4873-9c19-b07f1c8e2434"],

Cell[BoxData[
 FormBox[
  RowBox[{"h", "\[TildeTilde]", 
   FractionBox[
    RowBox[{
     FractionBox["dT", "dt"], "-", 
     RowBox[{"R", "(", "t", ")", " ", "T"}]}], "\[Gamma]"]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"398e1b08-d813-407f-9d8c-019066a273f3"],

Cell[TextData[{
 "Plugging in the most recent two-month tendency ",
 StyleBox["dT/dt",
  FontFamily->"Times",
  FontSlant->Italic],
 " = (T(Apr) \[Minus] T(Feb))/2 = 0.25 \[Degree]C/mo, the April seasonal \
feedback ",
 StyleBox["R(Apr) \[TildeTilde] \[Minus]0.21 month\[RightGuillemet]",
  FontFamily->"Times",
  FontSlant->Italic],
 ", and ",
 StyleBox["\[Gamma]",
  FontFamily->"Times",
  FontSlant->Italic],
 " = 0.06 gives an inferred ",
 StyleBox["h",
  FontFamily->"Times",
  FontSlant->Italic],
 " \[TildeTilde] +4.9, a large positive thermocline anomaly consistent with \
the substantial subsurface heat content remaining from the previous La Ni\
\[NTilde]a recharge."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"612fdbad-068d-4d3e-bf56-0ea4da86f8ee"],

Cell[TextData[{
 StyleBox["Caveat on this inversion.",
  FontSlant->Italic],
 " The expression above inverts only the ",
 StyleBox["deterministic skeleton",
  FontWeight->Bold],
 " of the SST equation. The actual observed ",
 StyleBox["dT/dt",
  FontFamily->"Times",
  FontSlant->Italic],
 " also contains contributions from the slow stochastic forcing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "T"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f7679afb-e2d0-499a-9488-0074fd984d9b"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "T"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b4f789a7-0c6e-480b-8771-63d257f308cc"],
 " and \[LongDash] in spring \[LongDash] a substantial westerly-wind-burst \
term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "w"], "(", "t", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b6bf776d-2ddc-41c7-a2cd-70ad8765aacc"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "w"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ed382c15-e162-4d7a-99a4-4039f7f49d39"],
 ". Attributing the entire spring warming to ",
 StyleBox["h",
  FontFamily->"Times",
  FontSlant->Italic],
 " therefore over-estimates the true thermocline anomaly: the inversion \
absorbs whatever spring WWB activity drove part of the observed tendency. A \
real-time SST-only proxy is unavoidable here because there is no clean \
machine-readable feed for the warm-water-volume index in the same monthly \
format as Ni\[NTilde]o 3.4; the NOAA PMEL TAO/TRITON mooring array publishes \
warm-water-volume but not in a format we can fetch in pure WL. Readers \
extending this notebook with a proper subsurface-data source should expect \
the forecast median to come down somewhat \[LongDash] our +2 to +3 \[Degree]C \
peak is therefore an ",
 StyleBox["upper-bound",
  FontSlant->Italic],
 " estimate."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"b377881d-a4ee-43bf-9ae4-f0c27e7e4769"],

Cell[TextData[{
 "With ",
 StyleBox["(T, h)",
  FontFamily->"Times",
  FontSlant->Italic],
 " = (+0.23, +4.9) as the initial condition, we run a 500-member RDO ensemble \
(200 in the live wlIn cell below) out 18 months (April 2026 \[RightArrow] \
October 2027). The resulting ",
 StyleBox["live toy-model forecast",
  FontWeight->Bold],
 ", with explicit 5\[Dash]95 % and 25\[Dash]75 % confidence intervals, is:"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"cc789f97-de68-45fe-b66b-53763d58ebaa"],

Cell[CellGroupData[{

Cell["\<\
(* Figure 6.1: live RDO forecast from observed April 2026 state.
   Re-uses simulate[] from the helpers package.
   PERFORMANCE: figure used 500 members (~90 s); this cell uses 200
   to keep it under 30 s. *)
n34 = LoadNino34[];
{Tlast, Tprev2, m0last} = {n34[\"anom\"][[-1]], n34[\"anom\"][[-3]],
                           n34[\"month\"][[-1]]};
dTdt = (Tlast - Tprev2)/2.;
hEst = (dTdt - Rseason[0., m0last] Tlast) / gammaC;
SeedRandom[2026];
nMem = 200;
PrintTemporary[\"Running \", nMem, \"-member RDO ensemble \\[Ellipsis]\"];
trajs = Table[
   simulate[Tlast, hEst, m0last, 18, 0.05, k],
   {k, nMem}];
Tmat = Transpose[#[\"T\"] & /@ trajs];
t    = trajs[[1, \"t\"]];
p05  = Map[Quantile[#, 0.05] &, Tmat];
p25  = Map[Quantile[#, 0.25] &, Tmat];
med  = Median /@ Tmat;
p75  = Map[Quantile[#, 0.75] &, Tmat];
p95  = Map[Quantile[#, 0.95] &, Tmat];

coneFig = Show[
   ListLinePlot[{Transpose[{t, p05}], Transpose[{t, p95}]},
      Filling -> {1 -> {{2}, Directive[Opacity[0.18],
         RGBColor[0.83, 0.32, 0.10]]}}],
   ListLinePlot[{Transpose[{t, p25}], Transpose[{t, p75}]},
      Filling -> {1 -> {{2}, Directive[Opacity[0.45],
         RGBColor[0.83, 0.32, 0.10]]}}],
   ListLinePlot[Transpose[{t, med}],
      PlotStyle -> Directive[Thickness[0.005], Black]],
   Frame -> True, PlotRange -> {{-12, 18}, {-3, 3}},
   FrameLabel -> {{\"Ni\\[NTilde]o 3.4 anomaly (\\[Degree]C)\", None},
                  {\"months from latest obs\", None}},
   ImageSize -> 900, AspectRatio -> 0.55]\
\>", "Input",
 CellMargins->{{60, 30}, {6, 6}},
 FontSize->11,ExpressionUUID->"ae35c32f-e46b-4344-8fd6-d14dc5d1441a"],

